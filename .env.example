# Required: speech-to-text — https://console.deepgram.com (API Keys)
DEEPGRAM_API_KEY=
# At least one of these: answers and translation
# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# ANTHROPIC_WORKSPACE_ID=                       # only for organization-wide keys
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_BACKUP_MODEL=claude-haiku-4-5-20251001  # "none" = no backup
# TRANSLATE_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-3.5-flash-lite
# DEEPGRAM_MODEL=nova-3
# AUDIO_SOURCE=@DEFAULT_MONITOR@                 # system output; `pactl list short sources` for others
# DEEPGRAM_KEYTERMS=Acme Labs,OpenCV,YOLO,PyTorch # names and technical terms, improves recognition
